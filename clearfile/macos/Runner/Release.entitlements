<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
        <key>com.apple.security.app-sandbox</key>
        <true/>
        <!-- Network client for the opt-in AI assistant (owner decision
             2026-11-14: "add and disclose"). Mirrors the Android INTERNET
             fix: release builds must be able to reach Google AI Studio /
             OpenRouter directly when the user enables the assistant with
             their own key. No server sockets, no other network use. -->
        <key>com.apple.security.network.client</key>
        <true/>
</dict>
</plist>
